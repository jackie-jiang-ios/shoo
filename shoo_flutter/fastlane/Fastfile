# Fastfile - Shoo App Store automation
default_platform(:ios)
APP_IDENTIFIER = "com.yangshiqin.shoo"
# Apple App Store Connect API 配置
ASC_KEY_ID = "29HD53FFYV"
ASC_ISSUER_ID = "4b86ecb0-5c72-4d3a-81b8-e6d62a056467"
ASC_KEY_FILEPATH = File.expand_path("./AuthKey_29HD53FFYV.p8")

# Apple App Store Connect 目录代码，与 fastlane/metadata 和 fastlane/screenshots 保持一致
LANGUAGES = ["ar-SA", "bn-BD", "ca", "cs", "da", "de-DE", "el", "en-AU", "en-CA", "en-GB", "en-US", "es-ES", "es-MX", "fi", "fr-CA", "fr-FR", "gu-IN", "he", "hi", "hr", "hu", "id", "it", "ja", "kn-IN", "ko", "ml-IN", "mr-IN", "ms", "nl-NL", "no", "or-IN", "pa-IN", "pl", "pt-BR", "ro", "ru", "sk", "sl-SI", "sv", "ta-IN", "te-IN", "th", "tr", "uk", "ur-PK", "vi", "zh-Hans", "zh-Hant"]

lane :screenshots do
  sh("bash", "../scripts/screenshot_all_langs.sh")
  UI.success("Screenshots done!")
end

lane :record_videos do
  sh("bash", "../scripts/record_all_videos.sh")
  UI.success("Videos done!")
end

lane :gen_tts do
  sh("python3", "../scripts/gen_tts_narrations.py")
  UI.success("TTS done!")
end

lane :gen_videos do
  gen_tts
  record_videos
  UI.success("Video pipeline done!")
end

lane :upload do
  api_key = app_store_connect_api_key(
    key_id: ASC_KEY_ID,
    issuer_id: ASC_ISSUER_ID,
    key_filepath: ASC_KEY_FILEPATH,
    in_house: false
  )
  deliver(
    api_key: api_key,
    app_identifier: APP_IDENTIFIER,
    metadata_path: "./metadata",
    screenshots_path: "./screenshots",
    force: true,
    automatic_release: false,
    overwrite_screenshots: true,
    overwrite_preview_videos: true,
    precheck_include_in_app_purchases: false,
    languages: LANGUAGES
  )
  UI.success("Upload done!")
end

lane :upload_metadata do
  api_key = app_store_connect_api_key(
    key_id: ASC_KEY_ID,
    issuer_id: ASC_ISSUER_ID,
    key_filepath: ASC_KEY_FILEPATH,
    in_house: false
  )
  deliver(
    api_key: api_key,
    app_identifier: APP_IDENTIFIER,
    metadata_path: "./metadata",
    force: true,
    skip_screenshots: true,
    automatic_release: false,
    precheck_include_in_app_purchases: false,
    languages: LANGUAGES
  )
  UI.success("Metadata upload done!")
end

lane :upload_screenshots do
  UI.message("=== upload_screenshots 开始 ===")
  UI.message("APP_IDENTIFIER: #{APP_IDENTIFIER}")

  # 列出 screenshots 目录中的内容
  screenshots_dir = File.expand_path("./screenshots", __dir__)
  UI.message("screenshots 路径: #{screenshots_dir}")
  if Dir.exist?(screenshots_dir)
    Dir.entries(screenshots_dir).sort.each do |entry|
      next if entry == "." || entry == ".."
      full_path = File.join(screenshots_dir, entry)
      if Dir.exist?(full_path)
        pngs = Dir.glob(File.join(full_path, "*.png"))
        UI.message("  📁 #{entry}/  (#{pngs.count} 张 png)")
        pngs.each { |p| UI.message("      - #{File.basename(p)}") }
      end
    end
  else
    UI.error("❌ screenshots 目录不存在: #{screenshots_dir}")
  end

  api_key = app_store_connect_api_key(
    key_id: ASC_KEY_ID,
    issuer_id: ASC_ISSUER_ID,
    key_filepath: ASC_KEY_FILEPATH,
    in_house: false
  )
  UI.message("API Key 创建成功")

  deliver(
    api_key: api_key,
    app_identifier: APP_IDENTIFIER,
    screenshots_path: "./screenshots",
    force: true,
    skip_metadata: true,
    overwrite_screenshots: true,
    overwrite_preview_videos: true,
    automatic_release: false,
    precheck_include_in_app_purchases: false,
    ignore_language_directory_validation: true,
    languages: LANGUAGES
  )
  UI.success("Screenshots upload done!")
end

