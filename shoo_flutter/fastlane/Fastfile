  UI.message("=== upload_zh_screenshots 开始 (仅中文) ===")
  api_key = app_store_connect_api_key(
    key_id: ASC_KEY_ID,
    issuer_id: ASC_ISSUER_ID,
    key_filepath: ASC_KEY_FILEPATH,
    in_house: false
  )
  deliver(
    api_key: api_key,
    app_identifier: APP_IDENTIFIER,
    screenshots_path: "./screenshots",
    force: true,
    skip_metadata: true,
    overwrite_screenshots: true,
    overwrite_preview_videos: true,
    automatic_release: false,
    precheck_include_in_app_purchases: false,
    ignore_language_directory_validation: true,
    languages: ["zh-Hans", "zh-Hant"]
  )
  UI.success("Chinese screenshots upload done!")
end

lane :upload_lang_screenshots do |options|
  lang = options[:lang] || "ar-SA"
  UI.message("=== upload_lang_screenshots 开始 (lang: #{lang}) ===")
  api_key = app_store_connect_api_key(
    key_id: ASC_KEY_ID,
    issuer_id: ASC_ISSUER_ID,
    key_filepath: ASC_KEY_FILEPATH,
    in_house: false
  )
  deliver(
    api_key: api_key,
    app_identifier: APP_IDENTIFIER,
    screenshots_path: "./screenshots",
    force: true,
    skip_metadata: true,
    overwrite_screenshots: true,
    overwrite_preview_videos: true,
    automatic_release: false,
    precheck_include_in_app_purchases: false,
    ignore_language_directory_validation: true,
    languages: [lang]
  )
  UI.success("Done: #{lang}")
end

