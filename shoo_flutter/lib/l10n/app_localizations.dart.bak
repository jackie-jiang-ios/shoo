  /// 翻译 Map 的 key：区分国家和地区的语言单独处理
  String get _code {
    if (locale.languageCode == 'zh' && locale.countryCode == 'TW') return 'zh_TW';
    if (locale.languageCode == 'fr' && locale.countryCode == 'CA') return 'fr_CA';
    if (locale.languageCode == 'es' && locale.countryCode == 'MX') return 'es_MX';
    if (locale.languageCode == 'en' && locale.countryCode == 'AU') return 'en_AU';
    if (locale.languageCode == 'en' && locale.countryCode == 'CA') return 'en_CA';
    if (locale.languageCode == 'en' && locale.countryCode == 'GB') return 'en_GB';
    return locale.languageCode;
  }

  /// 当前是否为中文环境（简体或繁体）
  bool get isZh => _code == 'zh' || _code == 'zh_TW';

  /// 多语言翻译查找：zh -> en -> fallback
  String _t(Map<String, String> translations) {
    return translations[_code] ?? translations['en'] ?? translations.values.first;
  }

